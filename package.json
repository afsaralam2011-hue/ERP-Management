{
  "name": "erp-system",
  "version": "1.0.0",
  "description": "ERP Management System",
  "private": true,
  "scripts": {
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "cd frontend && npm install && npm run build",
    "start:backend": "cd backend && npm start"
  },
  "keywords": [
    "erp-system",
    "management-system"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.0.0",
    "sequelize-cli": "^6.6.3"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "sequelize": "^6.37.7",
    "tailwindcss": "^4.1.18"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afsaralam2011-hue/ERP-Management.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/afsaralam2011-hue/ERP-Management/issues"
  },
  "homepage": "https://github.com/afsaralam2011-hue/ERP-Management#readme"
}
