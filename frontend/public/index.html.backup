<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="%PUBLIC_URL%/favicon.ico" />
    
    <!-- Viewport for Mobile Optimization -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0" />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#005461" />
    
    <!-- PWA Settings -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Spiral Section">
    
    <!-- Description -->
    <meta
      name="description"
      content="Pakistan Wire Industries - Management System"
    />
    
    <!-- Mobile Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="%PUBLIC_URL%/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="%PUBLIC_URL%/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="%PUBLIC_URL%/favicon-16x16.png">
    
    <!-- Manifest for PWA -->
    <link rel="manifest" href="%PUBLIC_URL%/manifest.json" />
    
    <!-- Fonts for Better Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

     <link rel="stylesheet" href="%PUBLIC_URL%/theme-variables.css" />
     <link rel="stylesheet" href="%PUBLIC_URL%/light-theme.css" />
     <link rel="stylesheet" href="%PUBLIC_URL%/dark-theme.css" />

     <script src="%PUBLIC_URL%/theme-toggle.js"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <title>Pakistan Wire Industries</title>
    
    <!-- Critical CSS for Fast Loading -->
    <style>
      /* Base Mobile Optimizations */
      * {
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      /* Allow text selection for inputs */
      input, textarea, select {
        -webkit-user-select: text;
        -moz-user-select: text;
        -ms-user-select: text;
        user-select: text;
        font-size: 16px; /* Prevent iOS zoom */
      }
      
      html {
        font-size: 14px;
        height: 100%;
        overflow-x: hidden;
      }
      
      @media (min-width: 768px) {
        html {
          font-size: 16px;
        }
      }
      
      /* Body Styles */
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Roboto', 'Oxygen',
          'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #ffffff;
        color: #1E293B;
        line-height: 1.5;
        height: 100%;
        overflow-x: hidden;
        touch-action: manipulation;
      }
      
      /* Root Container */
      #root {
        height: 100%;
        min-height: 100vh;
      }
      
      /* Welcome Screen Styles */
      .welcome-screen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #005461, #006D7C);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        color: white;
        text-align: center;
        padding: 2rem;
        transition: opacity 0.5s ease;
      }
      
      .welcome-logo {
        width: 180px;
        height: 180px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: pulse 2s infinite;
      }
      
      .welcome-logo img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
      }
      
      .welcome-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: 1px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
      }
      
      .welcome-subtitle {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-bottom: 2rem;
        max-width: 600px;
        line-height: 1.6;
      }
      
      .countdown-timer {
        font-size: 3rem;
        font-weight: bold;
        margin: 2rem 0;
        color: #00B7B5;
        text-shadow: 0 2px 10px rgba(0, 183, 181, 0.3);
        animation: countdownPulse 1s infinite;
      }
      
      .progress-bar {
        width: 300px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        overflow: hidden;
        margin: 2rem 0;
      }
      
      .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #00B7B5, #33C5C3);
        width: 0%;
        transition: width 0.3s ease;
        border-radius: 4px;
      }
      
      /* Loading States */
      .app-loading {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: linear-gradient(135deg, #005461, #006D7C);
        color: white;
      }
      
      .loading-spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: white;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
      }
      
      /* Theme Toggle Button Styles */
      .theme-toggle-button {
        background: #005461;
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        padding: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
      }
      
      .theme-toggle-button:hover {
        background: #003C45;
        transform: translateY(-2px);
      }
      
      /* Theme Change Notification */
      .theme-change-notification {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #F8FAFC;
        color: #1E293B;
        padding: 12px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        z-index: 9999;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #E2E8F0;
        animation: slideIn 0.3s ease, fadeOut 0.3s ease 2s forwards;
      }
      
      /* Animations */
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      
      @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
      }
      
      @keyframes countdownPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
      }
      
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(100%);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
      
      @keyframes fadeOut {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }
      
      /* Welcome screen elements animation */
      .welcome-screen > * {
        animation: fadeIn 0.8s ease-out forwards;
        opacity: 0;
      }
      
      .welcome-logo {
        animation-delay: 0.2s;
      }
      
      .welcome-title {
        animation-delay: 0.4s;
      }
      
      .welcome-subtitle {
        animation-delay: 0.6s;
      }
      
      .countdown-timer {
        animation-delay: 0.8s;
      }
      
      .progress-bar {
        animation-delay: 1s;
      }
      
      #skip-button {
        animation-delay: 1.2s;
      }
      
      /* Mobile Specific Adjustments */
      @media screen and (max-width: 768px) {
        .welcome-title {
          font-size: 2rem;
        }
        
        .welcome-subtitle {
          font-size: 1rem;
          padding: 0 1rem;
        }
        
        .welcome-logo {
          width: 140px;
          height: 140px;
        }
        
        .countdown-timer {
          font-size: 2.5rem;
        }
        
        .progress-bar {
          width: 250px;
        }
      }
      
      @media screen and (max-width: 480px) {
        .welcome-title {
          font-size: 1.8rem;
        }
        
        .welcome-logo {
          width: 120px;
          height: 120px;
        }
        
        .countdown-timer {
          font-size: 2rem;
        }
      }
      
      /* Dark theme adjustments for welcome screen */
      [data-theme="dark"] .welcome-screen {
        background: linear-gradient(135deg, #00363d, #005461);
        color: #f1f5f9;
      }
      
      [data-theme="dark"] .app-loading {
        background: linear-gradient(135deg, #00363d, #005461);
        color: #f1f5f9;
      }
    </style>
    
    <!-- Background Music (Optional) -->
    <audio id="background-music" preload="auto">
      <source src="%PUBLIC_URL%/audio/welcome-music.mp3" type="audio/mpeg">
      <source src="%PUBLIC_URL%/audio/welcome-music.ogg" type="audio/ogg">
      Your browser does not support the audio element.
    </audio>
  </head>
  <body>
    <noscript>
      <div class="noscript-container">
        <h1>JavaScript Required</h1>
        <p>
          This application requires JavaScript to function properly. Please enable JavaScript in your browser settings.
        </p>
        <p class="noscript-footer">
          Pakistan Wire Industries - Production Management System
        </p>
      </div>
      <style>
        .noscript-container {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: hsl(359, 80%, 33%);
          color: white;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 2rem;
          z-index: 9999;
        }
        
        .noscript-container h1 {
          margin-bottom: 1rem;
          color: white;
          font-size: 2rem;
        }
        
        .noscript-container p {
          margin-bottom: 2rem;
          max-width: 600px;
          font-size: 1.1rem;
          line-height: 1.6;
        }
        
        .noscript-footer {
          font-size: 0.9rem;
          opacity: 0.8;
          margin-top: 2rem;
        }
      </style>
    </noscript>
    
    <!-- Welcome Screen -->
    <div id="welcome-screen" class="welcome-screen">
      <div class="welcome-logo">
        <!-- Try multiple logo paths to ensure it works -->
        <img 
          src="%PUBLIC_URL%/logoA.png" 
          alt="Pakistan Wire Industries Logo" 
          id="company-logo"
          onerror="this.onerror=null; this.src='%PUBLIC_URL%/assets/images/logoA.png'; this.onerror=function(){handleLogoError(this);}"
        />
      </div>
      
      <h1 class="welcome-title">Pakistan Wire Industries</h1>
      
      <p class="welcome-subtitle">
        Welcome to the Production Management System.<br>
        Streamlining manufacturing operations with precision and efficiency.
      </p>
      
      <div class="countdown-timer" id="countdown">15</div>
      
      <div class="progress-bar">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
      
      <p class="mb-6" style="font-size: 1.1rem;">
        Loading application in <span id="countdown-text" style="font-weight: bold;">15</span> seconds
      </p>
      
      <button 
        id="skip-button" 
        class="px-8 py-3 bg-white/20 hover:bg-white/30 text-white font-semibold rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/30 hover:border-white/50 hover:shadow-lg transform hover:-translate-y-1"
        style="min-height: 48px; min-width: 180px;"
      >
        <span class="flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
          Skip to Login
        </span>
      </button>
      
      <!-- Theme Toggle Button for Welcome Screen -->
      <div class="mt-8">
        <button 
          id="welcome-theme-toggle"
          class="px-6 py-2 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/20 hover:border-white/40 hover:shadow-md flex items-center gap-2"
          onclick="toggleTheme()"
        >
          <span id="theme-icon">🌙</span>
          <span id="theme-text">Switch Theme</span>
        </button>
      </div>
      
      <div class="mt-10 text-sm opacity-70">
        <p>ERP System v2.0 | © 2024 Pakistan Wire Industries</p>
        <p class="mt-1" style="font-size: 0.8rem;">All Rights Reserved</p>
      </div>
    </div>
    
    <!-- Loading Screen -->
    <div id="loading-screen" class="app-loading" style="display: none;">
      <div class="loading-spinner"></div>
      <h2 style="margin-bottom: 0.5rem; text-align: center; font-size: 1.5rem;">
        Loading Application
      </h2>
      <p style="opacity: 0.8; text-align: center; max-width: 300px;">
        Pakistan Wire Industries Production Management System
      </p>
      <div class="mt-6 text-xs opacity-60">
        Initializing modules...
      </div>
    </div>
    
    <!-- Main App Container -->
    <div id="root"></div>
    
    <!-- Main Script -->
    <script>
      // Global variables
      let countdownInterval = null;
      let hasRedirected = false;
      let backgroundMusicStarted = false;
      
      // Simple theme toggle function
      function toggleTheme() {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('pwi_theme', newTheme);
        
        // Update button text
        const themeIcon = document.getElementById('theme-icon');
        const themeText = document.getElementById('theme-text');
        if (themeIcon && themeText) {
          if (newTheme === 'dark') {
            themeIcon.textContent = '☀️';
            themeText.textContent = 'Light Mode';
          } else {
            themeIcon.textContent = '🌙';
            themeText.textContent = 'Dark Mode';
          }
        }
        
        // Show notification
        const notification = document.createElement('div');
        notification.className = 'theme-change-notification';
        notification.innerHTML = `Switched to ${newTheme === 'dark' ? 'Dark' : 'Light'} theme`;
        document.body.appendChild(notification);
        
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 2000);
      }
      
      // Function to handle logo loading error
      function handleLogoError(imgElement) {
        console.log('Logo failed to load from all sources');
        
        // Create a fallback logo
        const logoContainer = imgElement.parentElement;
        logoContainer.innerHTML = `
          <div style="
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #00B7B5, #005461);
            border-radius: 50%;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
          ">
            PWI
          </div>
        `;
      }
      
      // Function to check if user is authenticated
      function isUserAuthenticated() {
        // Check multiple possible auth storage locations
        const authToken = localStorage.getItem('authToken') ||
                         sessionStorage.getItem('authToken') ||
                         localStorage.getItem('token') ||
                         sessionStorage.getItem('token');
        
        const userData = localStorage.getItem('user') ||
                        sessionStorage.getItem('user') ||
                        localStorage.getItem('userData') ||
                        sessionStorage.getItem('userData');
        
        return !!authToken || !!userData;
      }
      
      // Function to check if welcome screen should be shown
      function shouldShowWelcomeScreen() {
        // Check if user has already seen welcome screen today
        const lastWelcomeDate = localStorage.getItem('pwi_last_welcome_date');
        const today = new Date().toDateString();
        const welcomeDisabled = localStorage.getItem('pwi_welcome_disabled') === 'true';
        
        // Don't show if:
        // 1. User is already authenticated
        // 2. Welcome screen is disabled
        // 3. User saw welcome screen today
        if (isUserAuthenticated()) {
          console.log('User authenticated, skipping welcome screen');
          return false;
        }
        
        if (welcomeDisabled) {
          console.log('Welcome screen disabled by user');
          return false;
        }
        
        if (lastWelcomeDate === today) {
          console.log('Welcome screen already shown today');
          return false;
        }
        
        return true;
      }
      
      // Function to mark welcome screen as shown
      function markWelcomeScreenShown() {
        const today = new Date().toDateString();
        localStorage.setItem('pwi_last_welcome_date', today);
        console.log('Welcome screen marked as shown for today:', today);
      }
      
      // Function to disable welcome screen permanently
      function disableWelcomeScreen() {
        localStorage.setItem('pwi_welcome_disabled', 'true');
        console.log('Welcome screen disabled permanently');
      }
      
      // Function to start background music
      function startBackgroundMusic() {
        if (backgroundMusicStarted) return;
        
        const backgroundMusic = document.getElementById('background-music');
        if (backgroundMusic) {
          // Only start music if user has interacted with the page
          const startMusic = () => {
            backgroundMusic.volume = 0.15; // Low volume
            backgroundMusic.play().then(() => {
              console.log('Background music started');
              backgroundMusicStarted = true;
            }).catch(error => {
              console.log('Could not play background music:', error.message);
            });
          };
          
          // Add click event to start music
          document.addEventListener('click', startMusic, { once: true });
          document.addEventListener('touchstart', startMusic, { once: true });
          
          // Also try to start after a delay
          setTimeout(() => {
            if (!backgroundMusicStarted) {
              startMusic();
            }
          }, 2000);
        }
      }
      
      // Function to stop background music
      function stopBackgroundMusic() {
        const backgroundMusic = document.getElementById('background-music');
        if (backgroundMusic) {
          backgroundMusic.pause();
          backgroundMusic.currentTime = 0;
          backgroundMusicStarted = false;
          console.log('Background music stopped');
        }
      }
      
      // Function to trigger app navigation
      function triggerAppNavigation() {
        if (hasRedirected) {
          console.log('Navigation already triggered, skipping');
          return;
        }
        
        hasRedirected = true;
        
        // Stop background music
        stopBackgroundMusic();
        
        // Clear countdown interval
        if (countdownInterval) {
          clearInterval(countdownInterval);
          countdownInterval = null;
        }
        
        // Mark welcome screen as shown
        markWelcomeScreenShown();
        
        // Get current path
        const currentPath = window.location.pathname;
        console.log('Current path:', currentPath);
        
        // Check authentication
        const isAuthenticated = isUserAuthenticated();
        console.log('User authenticated:', isAuthenticated);
        
        // Determine where to navigate
        let targetPath = '/login';
        
        if (isAuthenticated) {
          // Already logged in, go to dashboard
          if (currentPath === '/' || currentPath === '/login' || currentPath === '') {
            targetPath = '/dashboard';
          } else {
            // Stay on current page
            targetPath = currentPath;
          }
        } else {
          // Not authenticated, go to login
          if (currentPath !== '/login' && currentPath !== '/register') {
            targetPath = '/login';
          } else {
            // Already on auth page
            targetPath = currentPath;
          }
        }
        
        console.log('Navigating to:', targetPath);
        
        // Fade out welcome screen
        const welcomeScreen = document.getElementById('welcome-screen');
        if (welcomeScreen) {
          welcomeScreen.style.opacity = '0';
          welcomeScreen.style.transition = 'opacity 0.5s ease';
          
          setTimeout(() => {
            welcomeScreen.style.display = 'none';
            
            // Show loading screen briefly
            const loadingScreen = document.getElementById('loading-screen');
            if (loadingScreen) {
              loadingScreen.style.display = 'flex';
              loadingScreen.style.opacity = '1';
              
              // Dispatch app-ready event for React to handle
              console.log('Dispatching app-ready event');
              const event = new CustomEvent('app-ready', {
                detail: {
                  timestamp: new Date().toISOString(),
                  targetPath: targetPath,
                  isAuthenticated: isAuthenticated
                }
              });
              window.dispatchEvent(event);
              
              // Also call global function if it exists
              if (window.triggerReactNavigation) {
                window.triggerReactNavigation(targetPath, isAuthenticated);
              }
              
              // Hide loading screen after React takes over
              setTimeout(() => {
                if (loadingScreen) {
                  loadingScreen.style.opacity = '0';
                  setTimeout(() => {
                    loadingScreen.style.display = 'none';
                  }, 500);
                }
              }, 1000);
            }
          }, 500);
        } else {
          // Welcome screen not found, trigger event immediately
          console.log('Dispatching app-ready event (no welcome screen)');
          const event = new CustomEvent('app-ready', {
            detail: {
              timestamp: new Date().toISOString(),
              targetPath: targetPath,
              isAuthenticated: isAuthenticated
            }
          });
          window.dispatchEvent(event);
        }
      }
      
      // Function to start countdown
      function startCountdown() {
        const countdownElement = document.getElementById('countdown');
        const countdownText = document.getElementById('countdown-text');
        const progressFill = document.getElementById('progress-fill');
        
        if (!countdownElement || !countdownText || !progressFill) {
          console.error('Countdown elements not found');
          triggerAppNavigation();
          return;
        }
        
        let timeLeft = 15;
        const totalTime = 15;
        
        countdownInterval = setInterval(() => {
          timeLeft--;
          
          // Update display
          countdownElement.textContent = timeLeft;
          countdownText.textContent = timeLeft;
          
          // Update progress bar
          const progressPercentage = ((totalTime - timeLeft) / totalTime) * 100;
          progressFill.style.width = `${progressPercentage}%`;
          
          // Change color when 5 seconds remain
          if (timeLeft <= 5) {
            countdownElement.style.color = '#EF4444';
            countdownElement.style.animation = 'none';
          }
          
          // Navigate when countdown reaches 0
          if (timeLeft <= 0) {
            triggerAppNavigation();
          }
        }, 1000);
      }
      
      // Function to setup theme toggle for welcome screen
      function setupWelcomeThemeToggle() {
        const welcomeThemeToggle = document.getElementById('welcome-theme-toggle');
        const themeIcon = document.getElementById('theme-icon');
        const themeText = document.getElementById('theme-text');
        
        if (!welcomeThemeToggle) return;
        
        // Get current theme
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        if (themeIcon && themeText) {
          if (currentTheme === 'dark') {
            themeIcon.textContent = '☀️';
            themeText.textContent = 'Light Mode';
          } else {
            themeIcon.textContent = '🌙';
            themeText.textContent = 'Dark Mode';
          }
        }
      }
      
      // Function to initialize welcome screen
      function initializeWelcomeScreen() {
        console.log('Initializing welcome screen...');
        
        // Check if welcome screen should be shown
        if (!shouldShowWelcomeScreen()) {
          console.log('Skipping welcome screen');
          triggerAppNavigation();
          return;
        }
        
        // Setup theme toggle for welcome screen
        setupWelcomeThemeToggle();
        
        // Start background music
        startBackgroundMusic();
        
        // Start countdown
        startCountdown();
        
        // Setup skip button
        const skipButton = document.getElementById('skip-button');
        if (skipButton) {
          skipButton.addEventListener('click', function() {
            console.log('Skip button clicked');
            disableWelcomeScreen();
            triggerAppNavigation();
          });
        }
        
        // Add double-click to disable welcome permanently
        const welcomeScreen = document.getElementById('welcome-screen');
        if (welcomeScreen) {
          let clickCount = 0;
          let clickTimer;
          
          welcomeScreen.addEventListener('click', function(e) {
            if (e.target.id !== 'skip-button' && e.target.id !== 'welcome-theme-toggle' && 
                e.target.parentElement.id !== 'welcome-theme-toggle') {
              clickCount++;
              
              if (clickCount === 1) {
                clickTimer = setTimeout(() => {
                  clickCount = 0;
                }, 500);
              }
              
              if (clickCount === 3) {
                clearTimeout(clickTimer);
                clickCount = 0;
                disableWelcomeScreen();
                alert('Welcome screen has been disabled permanently. Refresh to skip.');
              }
            }
          });
        }
        
        console.log('Welcome screen initialized');
      }
      
      // Initialize when DOM is loaded
      document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM loaded, starting initialization...');
        
        // Small delay to ensure everything is ready
        setTimeout(() => {
          initializeWelcomeScreen();
        }, 300);
      });
      
      // Global functions for React to call
      window.reactAppLoaded = function() {
        console.log('React app loaded callback received');
        
        // Hide any remaining loading screens
        const loadingScreen = document.getElementById('loading-screen');
        if (loadingScreen && loadingScreen.style.display !== 'none') {
          loadingScreen.style.opacity = '0';
          setTimeout(() => {
            loadingScreen.style.display = 'none';
          }, 300);
        }
      };
      
      // Handle page visibility changes
      document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible') {
          document.title = 'Pakistan Wire Industries';
          
          // Resume music if it was playing
          const backgroundMusic = document.getElementById('background-music');
          if (backgroundMusic && backgroundMusicStarted) {
            backgroundMusic.play().catch(e => {
              console.log('Could not resume music:', e.message);
            });
          }
        } else {
          // Pause music when page is hidden
          const backgroundMusic = document.getElementById('background-music');
          if (backgroundMusic) {
            backgroundMusic.pause();
          }
        }
      });
      
      // Performance monitoring
      window.addEventListener('load', function() {
        if (window.performance) {
          const perfData = window.performance.getEntriesByType('navigation')[0];
          const loadTime = perfData.loadEventEnd - perfData.fetchStart;
          console.log(`Page loaded in: ${loadTime.toFixed(2)}ms`);
          
          // Store performance data
          localStorage.setItem('pwi_last_load_time', loadTime.toFixed(2));
        }
      });
    </script>
  </body>
</html>